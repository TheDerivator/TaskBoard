  "changes": [
    {
      "id": "LM-07",
      "process_id": "LM",
      "title": "Argon stirring rate during trim",
      "why": "Reduce inclusions in ultra-low-carbon grades.",
      "owner": "AC"
    },
    {
      "id": "LM-08",
      "process_id": "LM",
      "title": "Desulphurisation flux, new supplier",
      "why": "Second source for flux: cost and supply security.",
      "owner": "BP"
    },
    {
      "id": "LM-09",
      "process_id": "LM",
      "title": "Ladle preheating +50 °C",
      "why": "Fewer skull problems at the start of a sequence.",
      "owner": "DW"
    },
    {
      "id": "LM-10",
      "process_id": "LM",
      "title": "Lower superheat for slab grades",
      "why": "Less centre segregation in slabs.",
      "owner": "CM"
    },
    {
      "id": "LM-11",
      "process_id": "LM",
      "title": "Calcium wire feeding sequence",
      "why": "Avoid nozzle clogging on Al-killed grades.",
      "owner": "FM"
    },
    {
      "id": "LM-12",
      "process_id": "LM",
      "title": "Temperature probe position",
      "why": "Readings drift at low ladle fill level.",
      "owner": "EJ"
    },
    {
      "id": "CV-21",
      "process_id": "CV",
      "title": "Oxygen lance height profile",
      "why": "Shorter blow time.",
      "owner": "DW"
    },
    {
      "id": "CV-22",
      "process_id": "CV",
      "title": "More shredded scrap in the mix",
      "why": "Lower hot-metal ratio.",
      "owner": "BP"
    },
    {
      "id": "CV-23",
      "process_id": "CV",
      "title": "Slag splashing duration",
      "why": "Longer refractory life.",
      "owner": "EJ"
    },
    {
      "id": "CV-24",
      "process_id": "CV",
      "title": "Bottom stirring gas flow",
      "why": "Better end-point control.",
      "owner": "FM"
    },
    {
      "id": "CC-31",
      "process_id": "CC",
      "title": "Mould powder type B",
      "why": "Fewer surface defects (see T-104).",
      "owner": "AC"
    },
    {
      "id": "CC-32",
      "process_id": "CC",
      "title": "Casting speed ramp at sequence start",
      "why": "Reduce breakout risk.",
      "owner": "DW"
    },
    {
      "id": "CC-33",
      "process_id": "CC",
      "title": "Secondary cooling pattern",
      "why": "Less corner cracking.",
      "owner": "CM"
    },
    {
      "id": "CC-34",
      "process_id": "CC",
      "title": "Tundish nozzle immersion depth",
      "why": "Meniscus stability.",
      "owner": "FM"
    }
  ],
