# Copy to .env for local development. Every setting is optional.

# TASKBOARD_ENVIRONMENT=development
# TASKBOARD_DATA_DIR=./var
# TASKBOARD_DATABASE_URL=sqlite:///./var/taskboard.sqlite3
# TASKBOARD_DATABASE_URL=mssql+pyodbc://user:password@server/taskboard?driver=ODBC+Driver+18+for+SQL+Server
# TASKBOARD_INITIAL_ADMIN_PASSWORD=change-me
# TASKBOARD_COOKIE_SECURE=true
# TASKBOARD_BASE_PATH=/taskboard/
# TASKBOARD_TRUSTED_PROXIES=127.0.0.1,::1

# SSO (off unless configured; see docs/AUTH.md)
# TASKBOARD_SSO_UNKNOWN_USERS=reject
# TASKBOARD_PUBLIC_URL=https://tasks.corp.example/taskboard/
# Microsoft Entra ID (OpenID Connect):
# TASKBOARD_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# TASKBOARD_OIDC_CLIENT_ID=<application (client) id>
# TASKBOARD_OIDC_CLIENT_SECRET=<secret value>
# TASKBOARD_OIDC_SUBJECT_CLAIM=oid
# Windows sign-in by TaskBoard itself (Windows servers, no IIS in front; docs/WINDOWS-SIGNIN.md):
# TASKBOARD_WINDOWS_AUTH=true
# TASKBOARD_WINDOWS_AUTH_AUTOMATIC=true
# TASKBOARD_WINDOWS_AUTH_STRIP_DOMAIN=true
# A proxy that authenticates users and passes them in a header (IIS's own modules cannot):
# TASKBOARD_TRUSTED_HEADER=X-Remote-User
# TASKBOARD_HOST=127.0.0.1
# TASKBOARD_PORT=8000
# HTTPS by the app itself, when no proxy in front does it (PEM files):
# TASKBOARD_TLS_CERTFILE=C:\TaskBoard\tls\cert.pem
# TASKBOARD_TLS_KEYFILE=C:\TaskBoard\tls\key.pem
